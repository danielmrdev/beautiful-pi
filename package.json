{
  "name": "beautiful-pi",
  "version": "0.3.0",
  "description": "Beautiful UI extensions for pi \u2014 footer, banner, and Nerd Fonts support",
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent",
    "terminal-ui"
  ],
  "author": "Daniel Mu\u00f1oz <github@danielmr.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/danielmrdev/beautiful-pi.git"
  },
  "bugs": {
    "url": "https://github.com/danielmrdev/beautiful-pi/issues"
  },
  "homepage": "https://github.com/danielmrdev/beautiful-pi#readme",
  "files": [
    "extensions",
    "assets",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "THIRD-PARTY-NOTICES.md"
  ],
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "test": "node --test --import=./test/setup.mjs --import=tsx extensions/**/*.test.ts test/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "pack:check": "pnpm pack --dry-run",
    "gitleaks:scan": "gitleaks detect --no-git --verbose -s .",
    "gitleaks:staged": "gitleaks protect --staged --verbose",
    "smoke": "node --import=./test/setup.mjs --import=tsx scripts/smoke.mjs"
  },
  "dependencies": {
    "@ogulcancelik/pi-codex-compaction": "0.1.6",
    "@hypabolic/pi-hypa": "1.2.0",
    "@plannotator/pi-extension": "0.28.26",
    "@tintinweb/pi-subagents": "0.22.0",
    "@juicesharp/rpiv-ask-user-question": "2.13.9",
    "@juicesharp/rpiv-btw": "2.13.9",
    "@juicesharp/rpiv-todo": "2.13.9",
    "pi-blackhole": "0.5.15"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=1.2.0 <1.5.0",
    "@earendil-works/pi-ai": ">=1.2.0 <1.5.0",
    "@earendil-works/pi-coding-agent": ">=1.2.0 <1.5.0",
    "@earendil-works/pi-tui": ">=1.2.0 <1.5.0"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts",
      "./extensions/compaction/codex-engine.ts",
      "../@hypabolic/pi-hypa/extensions/index.ts",
      "../@plannotator/pi-extension/index.ts",
      "../@tintinweb/pi-subagents/src/index.ts",
      "../@juicesharp/rpiv-ask-user-question/index.ts",
      "../@juicesharp/rpiv-btw/index.ts",
      "../@juicesharp/rpiv-todo/index.ts",
      "./extensions/compaction/blackhole-engine.ts"
    ],
    "skills": [
      "../@plannotator/pi-extension/skills/plannotator/SKILL.md"
    ],
    "prompts": [
      "../@juicesharp/rpiv-btw/prompts/btw-system.txt"
    ],
    "image": "https://raw.githubusercontent.com/danielmrdev/beautiful-pi/main/assets/beautiful-pi-screenshot.png"
  }
}
