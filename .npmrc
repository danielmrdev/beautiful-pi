# pi's git-based update runs `npm install --omit=dev` with this package.json
# as the ROOT project, where pi-rtk-optimizer is a direct dependency. npm
# ignores the overrides field for direct dependencies, so the peer range gap
# (pi-rtk-optimizer@0.9.0 peers stop at 0.80, pi is 0.83) hits ERESOLVE.
# Relax peer strictness so `pi update --extensions` resolves; runtime pi
# packages come from pi's own node_modules via upward resolution.
legacy-peer-deps=true
